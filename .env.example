# 签名密钥（运行 bun run release:keygen 生成）
# 推荐使用绝对路径；脚本也兼容 ~/.tauri/stoneflow.key
TAURI_SIGNING_PRIVATE_KEY=/Users/你的用户名/.tauri/stoneflow.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=你的密钥密码

# Cloudflare R2 配置（在 Cloudflare Dashboard → R2 → 管理 API 密钥 中获取）
R2_ACCOUNT_ID=你的 Cloudflare Account ID
R2_ACCESS_KEY_ID=你的 R2 Access Key ID
R2_SECRET_ACCESS_KEY=你的 R2 Secret Access Key
R2_BUCKET_NAME=你的 R2 Bucket 名称
# R2_PUBLIC_URL 默认为 https://release.sty20030818.space/stoneflow，一般不需要修改
# R2_PUBLIC_URL=https://release.sty20030818.space/stoneflow

# 本地 Tauri debug 同步数据库连接串：仅 Rust 进程读取，禁止使用 VITE_ 前缀。
# STONEFLOW_SYNC_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
