{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StoneFlow",
  "version": "0.1.0",
  "identifier": "com.stonefish.stoneflow",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build",
    "beforeBundleCommand": "bash -c 'if [ -f scripts/bundle-helper.sh ]; then bash scripts/bundle-helper.sh; else bash ../scripts/bundle-helper.sh; fi'"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
