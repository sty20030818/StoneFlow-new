{
	"name": "stoneflow",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsgo -b && vite build",
		"tauri": "tauri",
		"typecheck": "tsgo -b",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run test:run && bun run test:rust",
		"release": "bun run scripts/release/release.ts stable",
		"release:stable": "bun run scripts/release/release.ts stable",
		"release:beta": "bun run scripts/release/release.ts beta",
		"release:keygen": "bunx tauri signer generate -w ~/.tauri/stoneflow.key",
		"mock:updates": "bun run scripts/release/mock-server.ts",
		"mock:updates:beta": "bun run scripts/release/mock-server.ts --channel beta"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
		"@radix-ui/react-avatar": "^1.2.2",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-router": "^1.170.17",
		"@tanstack/router-plugin": "^1.168.19",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-store": "^2.4.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"es-toolkit": "^1.49.0",
		"lucide-react": "^1.24.0",
		"radix-ui": "^1.6.2",
		"react": "^19.2.7",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.7",
		"react-hook-form": "^7.81.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1085.0",
		"@tailwindcss/vite": "^4.3.2",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.1",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260707.2",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"jsdom": "^29.1.1",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"tailwindcss": "^4.3.2",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.1.4",
		"vitest": "^4.1.10"
	}
}
