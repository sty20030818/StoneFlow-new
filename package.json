{
	"name": "stoneflow",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsgo -b && vite build",
		"tauri": "tauri",
		"typecheck": "tsgo -b",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run test:run && bun run test:rust"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.4.0",
