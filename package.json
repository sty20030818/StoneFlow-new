{
	"name": "stoneflow",
	"version": "0.1.3",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"tauri": "tauri",
		"typecheck": "tsc -b",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:boundaries": "bun run scripts/check-feature-boundaries.ts",
		"check:animations": "bun run scripts/check-no-first-party-animation.ts",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"clean": "bun run scripts/clean.ts",
		"test": "vitest",
		"test:run": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:dom": "vitest run --project dom",
		"test:related": "vitest related --run",
		"test:changed": "vitest run --changed",
		"test:scripts": "bun test scripts",
		"test:release": "bun test scripts/release",
		"test:coverage": "vitest run --coverage",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
		"check": "bun run check:animations && bun run typecheck && bun run lint && bun run lint:boundaries && bun run format:check && bun run test:run && bun run test:scripts && bun run test:rust",
		"release": "bun run scripts/release/release.ts",
		"mock:updates": "bun run scripts/release/mock-server.ts",
		"mock:updates:beta": "bun run scripts/release/mock-server.ts -- --beta"
	},
	"dependencies": {
		"@heroui-pro/react": "1.0.0-beta.8",
		"@heroui/react": "3.2.4",
		"@heroui/styles": "3.2.4",
		"@hookform/resolvers": "^5.9.1",
		"@internationalized/date": "3.12.4",
		"@react-aria/utils": "3.34.1",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-virtual": "^3.14.10",
		"@tanstack/router-plugin": "^1.168.35",
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.3",
		"@tauri-apps/plugin-opener": "^2.5.5",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"es-toolkit": "^1.52.0",
		"lucide-react": "^1.39.0",
		"motion": "13.1.1",
		"react": "^19.2.8",
		"react-aria": "3.52.0",
		"react-aria-components": "1.21.0",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.87.0",
		"react-markdown": "10.1.0",
		"react-resizable-panels": "4.12.3",
		"react-stately": "3.50.0",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "3.3.1",
		"zod": "^4.5.4",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1124.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "^1.4.0",
		"@types/node": "^26.4.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^4.1.11",
		"jsdom": "^30.0.1",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"rollup-plugin-visualizer": "^7.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"trustedDependencies": [
		"@heroui-pro/react"
	]
}
