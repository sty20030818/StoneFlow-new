{
	"name": "stoneflow",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsgo -b && vite build",
		"tauri": "tauri",
		"typecheck": "tsgo -b",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"style:audit": "bash scripts/style-audit.sh",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
		"pretest:rust": "node scripts/cleanup-test-dbs.mjs --stale-only",
		"posttest:rust": "node scripts/cleanup-test-dbs.mjs",
		"cleanup:test-dbs": "node scripts/cleanup-test-dbs.mjs",
		"cleanup:test-dbs:stale": "node scripts/cleanup-test-dbs.mjs --stale-only",
		"test:rust:count-dbs": "node scripts/cleanup-test-dbs.mjs --count-only",
		"check": "bash scripts/style-audit.sh && bun run lint && bun run format:check && bun run test:run && bun run test:rust"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.1.12",
		"@tanstack/react-query": "^5.101.0",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-store": "^2.4.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"es-toolkit": "^1.47.1",
		"lucide-react": "^1.18.0",
		"radix-ui": "^1.5.0",
		"react": "^19.2.7",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.7",
		"react-router-dom": "^7.17.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.1",
		"@tauri-apps/cli": "^2.11.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.9.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260614.1",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.8",
		"jsdom": "^29.1.1",
		"oxfmt": "^0.54.0",
		"oxlint": "^1.69.0",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	}
}
