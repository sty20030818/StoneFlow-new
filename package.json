{
	"name": "stoneflow",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsgo -b && vite build",
		"typecheck": "tsgo -b",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"style:audit": "bash scripts/style-audit.sh",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
		"check": "bash scripts/style-audit.sh && bun run lint && bun run format:check && bun run test:run && bun run test:rust",
		"preview": "vite preview",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build"
	},
	"dependencies": {
		"@radix-ui/react-avatar": "^1.1.11",
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-opener": "^2.5.4",
		"@tauri-apps/plugin-store": "^2.4.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.2.1",
		"es-toolkit": "^1.46.1",
		"lucide-react": "^1.16.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.6",
		"react-router-dom": "^7.15.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2.11.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "^7.0.0-dev.20260521.1",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/coverage-v8": "^4.1.7",
		"jsdom": "^29.1.1",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.66.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"vite": "^8.0.14",
		"vitest": "^4.1.7"
	}
}
