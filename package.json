{
	"name": "stoneflow",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build && bun run check:bundle",
		"tauri": "tauri",
		"typecheck": "tsc -b",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:boundaries": "bun run scripts/check-feature-boundaries.ts",
		"check:animations": "bun run scripts/check-no-first-party-animation.ts",
		"check:bundle": "bun run scripts/check-bundle-budget.ts",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"clean": "bun run scripts/clean.ts",
		"test": "vitest",
		"test:run": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:dom": "vitest run --project dom",
		"test:related": "vitest related --run",
		"test:changed": "vitest run --changed",
		"test:scripts": "bun test scripts",
		"test:release": "bun test scripts/release",
		"test:coverage": "vitest run --coverage",
		"test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
		"check": "bun run check:animations && bun run typecheck && bun run lint && bun run lint:boundaries && bun run format:check && bun run test:run && bun run test:scripts && bun run test:rust",
		"release": "bun run scripts/release/release.ts",
		"mock:updates": "bun run scripts/release/mock-server.ts",
		"mock:updates:beta": "bun run scripts/release/mock-server.ts -- --beta"
	},
	"dependencies": {
		"@heroui-pro/react": "^1.0.0-beta.10",
		"@heroui/react": "^3.2.6",
		"@heroui/styles": "^3.2.6",
		"@hookform/resolvers": "^5.9.1",
		"@internationalized/date": "^3.12.4",
		"@react-aria/utils": "^3.34.1",
		"@tanstack/react-query": "^5.104.1",
		"@tanstack/react-router": "^1.170.41",
		"@tanstack/react-virtual": "^3.14.13",
		"@tanstack/router-plugin": "^1.168.42",
		"@tauri-apps/api": "^2.12.1",
		"@tauri-apps/plugin-dialog": "^2.8.1",
		"@tauri-apps/plugin-opener": "^2.7.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"es-toolkit": "^1.52.0",
		"lucide-react": "^1.53.0",
		"marked": "^18.1.0",
		"motion": "^14.0.0",
		"react": "^19.3.0",
		"react-aria": "^3.53.0",
		"react-aria-components": "^1.22.0",
		"react-dom": "^19.3.0",
		"react-hook-form": "^7.89.0",
		"react-markdown": "^10.1.0",
		"react-resizable-panels": "^4.14.3",
		"react-stately": "^3.51.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.5.0",
		"streamdown": "^2.7.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1147.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^5.0.3",
		"jsdom": "^30.1.2",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"rollup-plugin-visualizer": "^7.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"overrides": {
		"figlet": "1.11.3",
		"tar": "7.5.22"
	},
	"trustedDependencies": [
		"@heroui-pro/react"
	]
}
